import threading
import time
import customtkinter as ctk

ctk.set_appearance_mode("System")
ctk.set_default_color_theme("blue")


class ForexBotApp(ctk.CTk):

  def __init__(self):
    super().__init__()
    self.title("AI Forex Trading Dashboard")
    self.geometry("650x450")

    self.is_running = False

    # Status Label
    self.status_label = ctk.CTkLabel(
        self, text="Bot Status: Offline", font=("Arial", 16, "bold")
    )
    self.status_label.pack(pady=30)

    # Start/Stop Button
    self.btn_toggle = ctk.CTkButton(
        self, text="Start Bot", command=self.toggle_bot, fg_color="green"
    )
    self.btn_toggle.pack(pady=10)

    # Log Box for Activity
    self.log_box = ctk.CTkTextbox(self, width=550, height=200)
    self.log_box.pack(pady=20)
    self.log_box.insert("0.0", "System initialized. Ready to connect...\n")

  def toggle_bot(self):
    if not self.is_running:
      self.is_running = True
      self.btn_toggle.configure(text="Stop Bot", fg_color="red")
      self.status_label.configure(text="Bot Status: Running (Live Feed Active)")
      self.log_box.insert("end", "Connecting to MT5 and starting ML loop...\n")
      # Start background thread to avoid freezing the UI
      threading.Thread(target=self.run_trading_loop, daemon=True).start()
    else:
      self.is_running = False
      self.btn_toggle.configure(text="Start Bot", fg_color="green")
      self.status_label.configure(text="Bot Status: Offline")
      self.log_box.insert("end", "Bot stopped by user.\n")

  def run_trading_loop(self):
    while self.is_running:
      # TODO: Insert your MT5 data fetch, ML prediction, and order execution logic here
      self.log_box.insert("end", "Fetching tick data & evaluating ML model...\n")
      self.log_box.see("end")
      time.sleep(3)


if __name__ == "__main__":
  app = ForexBotApp()
  app.mainloop()
